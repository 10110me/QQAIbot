# Run scripts/init_env.py to create .env with random, distinct tokens.
OSA_ADMIN_TOKEN=replace-with-a-random-admin-token
OSA_NAPCAT_TOKEN=replace-with-a-different-napcat-token
OSA_DATABASE_URL=sqlite+aiosqlite:///./osa.db
OSA_AUTO_CREATE_SCHEMA=false
OSA_BOT_ID=99999
OSA_ALLOWED_GROUPS=["10001","10002"]
# QQ IDs allowed to register external bots from group chat. QQ group owners/admins are also accepted when NapCat supplies sender.role.
OSA_QQ_ADMIN_IDS=[]
OSA_BOT_SKILLS_ENABLED=true
OSA_PRIVATE_ENABLED=false

# Demo only. Live deployment: demo=false, provider=openai, configure an API key.
OSA_DEMO_MODE=true
OSA_MODEL_PROVIDER=fake
OSA_MODEL_BASE_URL=https://api.openai.com/v1
OSA_MODEL_API_KEY=
OSA_CHAT_MODEL=configured-chat-model
# OSA_DECISION_MODEL=configured-fast-model
# V3 uses the thinking model to decide whether to act and to write the final reply.
# These legacy settings remain for V2 compatibility; V3 always uses integrated replies.
OSA_DECISION_MODE=local
OSA_REPLY_MODE=integrated
# 0 = unlimited model calls; set a positive value to enforce a daily quota.
OSA_MAX_DAILY_MODEL_CALLS=0
OSA_WORKER_CONCURRENCY=4
OSA_TASK_CONCURRENCY=3
OSA_DATABASE_POOL_SIZE=5
OSA_HOST=127.0.0.1
OSA_PORT=8080

# Full-feature services. init_env.py generates the shared worker token.
OSA_WORKER_TOKEN=replace-with-a-random-worker-token
OSA_FEATURES_ENABLED=true
OSA_DATA_DIR=./data
OSA_RESEARCH_ENABLED=true
OSA_DEEPSEEK_WEB_ENABLED=true
OSA_DEEPSEEK_TRIGGER=always
OSA_BROWSER_WORKER_URL=http://127.0.0.1:8090
OSA_BROWSER_VNC_URL=http://127.0.0.1:6080
# Set true behind HTTPS; localhost HTTP uses false.
OSA_BROWSER_COOKIE_SECURE=false
OSA_SEARCH_PROVIDER=searxng
OSA_SEARCH_BASE_URL=http://127.0.0.1:8888
OSA_MAX_DAILY_RESEARCH_CALLS=30
OSA_MEDIA_ENABLED=false
# OSA_VISION_MODEL=your-vision-model
OSA_AUDIO_MODEL=whisper-1
# Legacy V2 only; V3 does not use TTS.
OSA_TTS_MODEL=tts-1
OSA_EMBEDDING_DIMENSION=1024
# OSA_EMBEDDING_BASE_URL=https://your-embedding-provider/v1
# OSA_EMBEDDING_MODEL=your-embedding-model
# OSA_EMBEDDING_API_KEY=your-key
OSA_INDEXER_WORKER_URL=http://127.0.0.1:8092
OSA_SANDBOX_ENABLED=false
OSA_SANDBOX_WORKER_URL=http://127.0.0.1:8091
OSA_QZONE_ENABLED=false
# OSA_QZONE_ADAPTER_URL=http://your-qzone-adapter:8095
# OSA_QZONE_ADAPTER_TOKEN=your-adapter-token
OSA_RETENTION_DAYS=30
OSA_NIGHTLY_HOUR=3
OSA_OBJECT_STORE=local
# S3 mode uses standard AWS environment credentials or workload identity.
# OSA_S3_ENDPOINT=http://minio:9000
# OSA_S3_BUCKET=osa
OSA_SCREENSHOT_WORKER_URL=http://127.0.0.1:8093
OSA_QQBOT_API_URL=
OSA_QQBOT_TIMEOUT=600
OSA_QQBOT_TOOLS_CACHE_SECONDS=86400
# Optional scoped console accounts. Use independent random tokens (24+ characters).
# OSA_ADMIN_ACCOUNTS=[{"name":"reviewer","token":"replace-with-an-independent-random-token","role":"reviewer","groups":["10001"]}]
# Website selectors can change with the DeepSeek version; override if needed.
DEEPSEEK_INPUT_SELECTOR=textarea, [contenteditable='true']
DEEPSEEK_ANSWER_SELECTOR=.ds-markdown
DEEPSEEK_SEND_SELECTOR=
DEEPSEEK_NEW_CHAT_SELECTOR=
DEEPSEEK_SEARCH_TOGGLE_SELECTOR=
DEEPSEEK_SEARCH_ENABLED_SELECTOR=
# For --profile sandbox, this is an absolute directory on the Docker daemon host.
# OSA_SANDBOX_HOST_DIR=/tmp/osa-sandbox-jobs

# Select normal / lowmem in startup.ini, then run python3 start.py up.
# The launcher manages resource limits/concurrency; credentials stay in this file.
# OSA_BIND_ADDRESS=127.0.0.1

# V2 control plane, independent work and research budgets.
OSA_DB_PASSWORD=replace-with-a-random-database-password
OSA_V2_ENABLED=true
OSA_V2_DATABASE_URL=./data/registry.db
OSA_WORKSPACE_DIR=./data/workspaces
# startup.ini work controls the container value.
OSA_WORK_ENABLED=false
# Optional separate work account/model; otherwise use configured chat endpoint.
# OSA_WORK_MODEL_API_KEY=
# OSA_WORK_MODEL_BASE_URL=https://your-provider/v1
# OSA_WORK_MODEL=your-code-model
OSA_WORK_DAILY_MODEL_CALLS=0
OSA_NIGHTLY_RESEARCH_LIMIT=20

OSA_ECHO_TOKEN=replace-with-a-random-echo-state-token
OSA_WORK_MAX_TOKENS=8192

# V3 core roles; /models can set separate vendors for decision/thinking/reply/memory.
OSA_V3_ENABLED=true
OSA_DECISION_MODE=llm
OSA_DECISION_CONFIDENCE_THRESHOLD=0.8
OSA_THINKING_MODEL=
OSA_REPLY_MODEL=
OSA_MEMORY_MODEL=
OSA_GLOBAL_GROUP_MEMORY=false
# Independent read-only observer; blank means snapshot-only, no model review.
OSA_OBSERVER_MODEL=
OSA_OBSERVER_BASE_URL=
OSA_OBSERVER_API_KEY=
OSA_MAX_DAILY_OBSERVER_CALLS=0
# Host Python only: Docker reads coding=builtin/opencode/codex from startup.ini.
OSA_CODING_PROVIDER=builtin
OSA_OPENCODE_ENDPOINT=
OSA_OPENCODE_PASSWORD=
OSA_OPENCODE_USERNAME=opencode
OSA_OPENCODE_VERSION=1.2.27
# External servers only: set true after providing per-workspace isolation.
OSA_OPENCODE_ISOLATION_CONFIRMED=false

# Docker manages isolated per-workspace servers by default in coding=opencode mode.
OSA_OPENCODE_MANAGED_GATEWAY=true

# coding=codex uses the work model configured in WebUI by default, including its key.
# Optional override for an endpoint with native Responses API support.
# Desktop CC Switch settings are not shared with the NAS.
# OSA_CODEX_API_KEY=
# OSA_CODEX_BASE_URL=https://api.openai.com/v1
# OSA_CODEX_MODEL=your-responses-model-id

# 群机器人命令学习模块暂时停用；保留已有观察记录。
OSA_BOT_SKILLS_ENABLED=false
